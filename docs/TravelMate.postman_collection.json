{
  "info": {
    "name": "TravelMate Discovery API",
    "description": "Run Register first or Login with an existing account. Token and ids are captured automatically. Demo seed: php artisan db:seed --class=DiscoveryDemoSeeder. Select a local file before Upload photo. Dates are generated relative to today. See DISCOVERY_API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "TravelMateTest123!"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "trip_id",
      "value": ""
    },
    {
      "key": "start_date",
      "value": ""
    },
    {
      "key": "end_date",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('email')) pm.collectionVariables.set('email', `postman-${Date.now()}@example.com`);",
          "const start = new Date(); start.setUTCDate(start.getUTCDate() + 14);",
          "const end = new Date(start); end.setUTCDate(end.getUTCDate() + 3);",
          "pm.collectionVariables.set('start_date', start.toISOString().slice(0,10));",
          "pm.collectionVariables.set('end_date', end.toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register test account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Traveler\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json(); if (result.token) pm.collectionVariables.set('token', result.token);",
                  "if (result.user) pm.collectionVariables.set('user_id', result.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json(); if (result.token) pm.collectionVariables.set('token', result.token);",
                  "if (result.user) pm.collectionVariables.set('user_id', result.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/user"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
